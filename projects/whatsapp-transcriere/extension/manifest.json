{
  "manifest_version": 3,
  "name": "WhatsApp Transcriere",
  "version": "1.0",
  "description": "Buton „Transcrie” la mesajele vocale din WhatsApp Web, transcrise local cu whisper.",
  "key": "",
  "permissions": ["nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
